
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techsonic-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "INTELLIGENCE",
      "id": "0e8b60d1a482422fbf981fdcf2b61742"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*", "/.well-known/ard.json"]
  },
  "triggers": {
    "crons": ["0 14 * * MON"]
  },
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ],
  "vars": {
    "SITE_ORIGIN": "https://www.gotechsonic.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFqKBWBNhkHpumTp",
    "AI_PROVIDER": "openai",
    "AI_MODEL": "gpt-6-luna"
  },
  "secrets": {
    "required": [
      "AI_PROVIDER_KEY",
      "TURNSTILE_SECRET",
      "BREVO_API_KEY",
      "BREVO_SENDER",
      "CONTACT_TO"
    ]
  }
}
